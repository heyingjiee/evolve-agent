# 基础模型配置
# 推荐使用下面这组变量名
API_KEY=your_api_key_here
MODEL=claude-sonnet-4-20250514
BASE_URL=

# 兼容旧变量名
# 如果你仍在使用旧配置，也可以填写下面这些字段
# ANTHROPIC_API_KEY=your_api_key_here
# MODEL_ID=claude-sonnet-4-20250514
# ANTHROPIC_BASE_URL=

# 模型调用参数
MAX_TOKENS=4096
TEMPERATURE=0

# 经过多少轮触发计划提醒
REMINDER_INTERVAL=3

# 工具结果持久化配置
# 工具结果字符数超过该阈值时，自动落盘到本地文件
PERSIST_THRESHOLD=30000
# 超过阈值后，工具结果保存目录
TOOL_RESULTS_DIR=.evolve/compact/tool-outputs
# 返回给模型的预览字符数
PREVIEW_CHARS=2000
# 保留最近多少条完整工具结果，其余长结果会被压缩提示替代
KEEP_RECENT_TOOL_RESULTS=3

# 历史对话压缩配置
# 对话上下文字符数超过该阈值时，触发历史压缩
CONTEXT_LIMIT=50000
# 历史对话 transcript 保存目录
TRANSCRIPT_DIR=.evolve/compact/transcripts
